# Core app mode
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Postgres
POSTGRES_DB=learning_english
POSTGRES_USER=learning_english
POSTGRES_PASSWORD=learning_english
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Object storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=learning-english

# API runtime
API_PORT=8000
JWT_SECRET=replace-with-32-byte-secret
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_PATH_STYLE=true
PROVIDER_MODE=qwen
AI_PROVIDER=qwen

# Doubao / Volcengine Ark providers
# Set AI_PROVIDER=doubao to enable real worksheet OCR and parsing.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL_OR_ENDPOINT=
DOUBAO_TEXT_MODEL_OR_ENDPOINT=
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_IMAGE_COUNT=5
AI_HTTP_TRUST_ENV=false

# Stub/default auth providers for MVP
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PHONE_OTP_MODE=debug

# DashScope / Alibaba Model Studio providers
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max-latest
QWEN_MODEL=qwen-plus

# Learning asset media provider
MEDIA_PROVIDER=real
MEDIA_IMAGE_PROVIDER=dashscope
MEDIA_TTS_PROVIDER=dashscope
MEDIA_IMAGE_MODEL=wan2.6-image
MEDIA_IMAGE_EDIT_MODEL=wanx2.1-imageedit
MEDIA_TTS_MODEL=cosyvoice-v3-flash
MEDIA_TTS_US_VOICE=longanyang
MEDIA_TTS_UK_VOICE=longanhuan
MEDIA_REQUEST_TIMEOUT_SECONDS=180
MEDIA_HTTP_TRUST_ENV=false
MEDIA_PROVIDER_POLL_INTERVAL_SECONDS=10
MEDIA_PROVIDER_MAX_POLL_SECONDS=180
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Speaking assessment
SPEECH_PROVIDER=dashscope
SPEECH_ASSESSMENT_PROVIDER=dashscope
SPEECH_ASSESSMENT_BASE_URL=https://dashscope.aliyuncs.com/api/v1
SPEECH_ASSESSMENT_APP_KEY=
SPEECH_ASSESSMENT_SECRET_KEY=
SPEECH_ASSESSMENT_ASR_MODEL=paraformer-v2
SPEECH_ASSESSMENT_SCORING_MODEL=qwen-plus
SPEECH_ASSESSMENT_POLL_INTERVAL_SECONDS=1
SPEECH_ASSESSMENT_MAX_POLL_SECONDS=120
SPEECH_ASSESSMENT_TIMEOUT_SECONDS=120
SPEECH_ASSESSMENT_HTTP_TRUST_ENV=false
SPEECH_ASSESSMENT_DEFAULT_ACCENT=am
SPEECH_ASSESSMENT_AUDIO_PUBLIC_BASE_URL=
SPEAKING_AUDIO_MAX_BYTES=10485760
