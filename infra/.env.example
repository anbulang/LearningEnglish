# Core app mode
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Postgres
POSTGRES_DB=learning_english
POSTGRES_USER=learning_english
POSTGRES_PASSWORD=learning_english
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Object storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=learning-english

# API runtime
API_PORT=8000
JWT_SECRET=replace-with-32-byte-secret
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_PATH_STYLE=true
PROVIDER_MODE=stub

# Stub/default auth providers for MVP
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PHONE_OTP_MODE=debug

# Optional AI providers for next phase
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
