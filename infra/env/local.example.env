POSTGRES_DB=learning_english
POSTGRES_USER=learning_english
POSTGRES_PASSWORD=learning_english
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000

# AI provider defaults. `stub` can run the MVP chain without external keys.
AI_PROVIDER=stub
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL_OR_ENDPOINT=
DOUBAO_TEXT_MODEL_OR_ENDPOINT=
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_IMAGE_COUNT=5

# Keep false by default so API/worker do not accidentally inherit system proxy
# credentials. Set true only when the current network requires HTTP_PROXY /
# HTTPS_PROXY / NO_PROXY for Doubao or other provider access.
AI_HTTP_TRUST_ENV=false

# Learning asset media provider.
# `mock` is deterministic for tests and local UI screenshots.
# `real` calls configured external providers and fails visibly if required
# keys/models are missing.
MEDIA_PROVIDER=mock
MEDIA_IMAGE_PROVIDER=openai
MEDIA_TTS_PROVIDER=openai
MEDIA_IMAGE_MODEL=gpt-image-2
MEDIA_TTS_MODEL=gpt-4o-mini-tts
MEDIA_TTS_US_VOICE=coral
MEDIA_TTS_UK_VOICE=cedar
MEDIA_REQUEST_TIMEOUT_SECONDS=180
MEDIA_HTTP_TRUST_ENV=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
