# Production env template for infra/docker-compose.prod.yml.
# Copy to infra/env/prod.env and fill the values marked「必填」. Never commit the
# filled prod.env (it holds real secrets). DATABASE_URL / PUBLIC_BASE_URL /
# STORAGE_BACKEND / LOCAL_STORAGE_PATH / APP_ENV are wired by the compose file —
# do not set them here.
#
#   docker compose --env-file infra/env/prod.env -f infra/docker-compose.prod.yml up -d --build
#
# See docs/harness/public-deploy-runbook.md for the full deploy steps.

# ── 必填：公网域名（DNS A 记录已指向本机；Caddy 据此签发 HTTPS 证书）──
PUBLIC_DOMAIN=api.example.com

# ── 必填：数据库 ──
POSTGRES_DB=learning_english
POSTGRES_USER=learning_english
POSTGRES_PASSWORD=change-me-strong-db-password

# ── 必填：应用密钥 ──
# 32+ 字节随机串，例如 `openssl rand -hex 32`
JWT_SECRET=change-me-32-byte-random-secret
# 运维后台 X-Admin-Token
ADMIN_API_TOKEN=change-me-admin-token

# ── 必填：身份（试点白名单）──
IDENTITY_PROVIDER=pilot
# 每个家庭一个 code，App 用它登录；服务端按 code 隔离账号。
PILOT_ALLOWLIST_JSON=[{"code":"fam-001","display_name":"林家","phone":"13800000001"},{"code":"fam-002","display_name":"赵家","phone":"13800000002"}]

# ── 必填：AI / 媒体 / 口语 provider 密钥（阿里云 DashScope）──
DASHSCOPE_API_KEY=change-me-dashscope-key

# ── provider 档位（真实路径默认值，一般无需改）──
AI_PROVIDER=qwen
QWEN_VISION_MODEL=qwen-vl-max
QWEN_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

MEDIA_PROVIDER=real
MEDIA_IMAGE_PROVIDER=dashscope
MEDIA_TTS_PROVIDER=dashscope
MEDIA_IMAGE_MODEL=wan2.6-image
MEDIA_IMAGE_EDIT_MODEL=wanx2.1-imageedit
MEDIA_TTS_MODEL=cosyvoice-v3-flash
MEDIA_TTS_US_VOICE=longanyang
MEDIA_TTS_UK_VOICE=longanhuan

SPEECH_PROVIDER=dashscope
SPEECH_ASSESSMENT_PROVIDER=dashscope
SPEECH_ASSESSMENT_BASE_URL=https://dashscope.aliyuncs.com/api/v1
SPEECH_ASSESSMENT_ASR_MODEL=paraformer-v2
SPEECH_ASSESSMENT_SCORING_MODEL=qwen-plus

# 若服务器需经代理才能访问 provider，置 true 并在 host 上设置 HTTP(S)_PROXY。
AI_HTTP_TRUST_ENV=false
MEDIA_HTTP_TRUST_ENV=false
SPEECH_ASSESSMENT_HTTP_TRUST_ENV=false
